<script>


/* =========================
   基本変数
========================= */

let stream = null;

let timerInterval = null;

let seconds = 0;

let selectedPersonality = null;

let utauZip = null;

let utauInfo = null;


/* =========================
   DOM
========================= */

const statusText =
document.getElementById("status");

const timer =
document.getElementById("timer");

const voiceFile =
document.getElementById("voiceFile");

const fileName =
document.getElementById("fileName");

const voiceResult =
document.getElementById("voiceResult");

const customPersonality =
document.getElementById("customPersonality");

const characterName =
document.getElementById("characterName");

const avatar =
document.getElementById("avatar");

const startButton =
document.getElementById("startButton");

const micButton =
document.getElementById("micButton");


/* =========================
   性格選択
========================= */

document
.querySelectorAll(".personalityButton")
.forEach(button => {

  button.addEventListener("click", () => {


    document
    .querySelectorAll(".personalityButton")
    .forEach(b => {

      b.classList.remove("selected");

    });


    button.classList.add("selected");


    selectedPersonality =
    button.dataset.type;


    if (
      selectedPersonality === "custom"
    ) {

      customPersonality.style.display =
      "block";

    } else {

      customPersonality.style.display =
      "none";

    }


    /* キャラクター表示 */

    if (
      selectedPersonality === "tanaka"
    ) {

      characterName.textContent =
      "田中";

      avatar.textContent =
      "👴";

    }


    else if (
      selectedPersonality === "jagajaga"
    ) {

      characterName.textContent =
      "じゃがじゃが";

      avatar.textContent =
      "🥔";

    }


    else {

      characterName.textContent =
      "オリジナルAI";

      avatar.textContent =
      "🎤";

    }

  });

});


/* =========================
   UTAU ZIP
========================= */

voiceFile.addEventListener(
"change",
async () => {


  voiceResult.innerHTML =
  "🔍 UTAU音源を確認しています……";


  utauZip = null;

  utauInfo = null;


  if (
    !voiceFile.files.length
  ) {

    fileName.textContent =
    "まだ選択されていません";

    voiceResult.innerHTML =
    "";

    return;

  }


  const file =
  voiceFile.files[0];


  fileName.textContent =
  "選択中: " + file.name;


  /* ZIP確認 */

  if (
    !file.name
    .toLowerCase()
    .endsWith(".zip")
  ) {

    voiceResult.innerHTML =
    "<div class='voiceError'>❌ ZIPファイルを選択してください。</div>";

    return;

  }


  try {


    const zip =
    await JSZip.loadAsync(file);


    utauZip = zip;


    const files =
    Object.keys(zip.files);


    let wavCount = 0;

    let frqCount = 0;

    let otoCount = 0;

    let txtCount = 0;

    let iniCount = 0;


    let otoFiles = [];


    files.forEach(path => {


      const lower =
      path.toLowerCase();


      if (
        lower.endsWith(".wav")
      ) {

        wavCount++;

      }


      if (
        lower.endsWith(".frq")
      ) {

        frqCount++;

      }


      if (
        lower.endsWith("oto.ini")
      ) {

        otoCount++;

        otoFiles.push(path);

      }


      if (
        lower.endsWith(".txt")
      ) {

        txtCount++;

      }


      if (
        lower.endsWith(".ini")
      ) {

        iniCount++;

      }

    });


    /* 音源名候補 */

    let voiceName =
    file.name.replace(
      /\.zip$/i,
      ""
    );


    if (
      otoFiles.length > 0
    ) {

      const firstOto =
      otoFiles[0];

      const parts =
      firstOto.split("/");

      if (
        parts.length >= 2
      ) {

        voiceName =
        parts[parts.length - 2];

      }

    }


    utauInfo = {

      fileName: file.name,

      voiceName: voiceName,

      fileCount: files.length,

      wavCount: wavCount,

      frqCount: frqCount,

      otoCount: otoCount,

      txtCount: txtCount,

      iniCount: iniCount

    };


    /* 結果表示 */

    let html = "";


    html +=
    "<div class='voiceCheckTitle'>📦 音源チェック結果</div>";


    html +=
    "<div>🎤 音源名候補：" +
    escapeHTML(voiceName) +
    "</div>";


    html +=
    "<div>📁 ファイル数：" +
    files.length +
    "</div>";


    html +=
    "<div>🎵 WAV：" +
    wavCount +
    "個</div>";


    html +=
    "<div>📊 FRQ：" +
    frqCount +
    "個</div>";


    html +=
    "<div>⚙️ oto.ini：" +
    otoCount +
    "個</div>";


    html +=
    "<div>📝 TXT：" +
    txtCount +
    "個</div>";


    html +=
    "<div>⚙️ INI：" +
    iniCount +
    "個</div>";


    if (
      wavCount > 0 &&
      otoCount > 0
    ) {


      html +=
      "<div class='voiceOK'>✅ UTAU音源らしい構成を確認しました！</div>";


    }

    else if (
      wavCount > 0
    ) {


      html +=
      "<div class='voiceWarning'>⚠️ WAVは見つかりましたが、oto.iniが見つかりません。</div>";


    }

    else {


      html +=
      "<div class='voiceError'>❌ UTAU音源として必要なファイルを確認できませんでした。</div>";

    }


    voiceResult.innerHTML =
    html;


  }

  catch(error) {


    console.error(error);


    utauZip = null;

    utauInfo = null;


    voiceResult.innerHTML =
    "<div class='voiceError'>❌ ZIPを読み込めませんでした。</div>";

  }

});


/* =========================
   HTML安全化
========================= */

function escapeHTML(text) {

  return String(text)

    .replace(/&/g, "&amp;")

    .replace(/</g, "&lt;")

    .replace(/>/g, "&gt;")

    .replace(/"/g, "&quot;")

    .replace(/'/g, "&#039;");

}


/* =========================
   性格チェック
========================= */

function checkPersonality() {


  if (
    !selectedPersonality
  ) {

    alert(
      "まず性格を選択してください！"
    );

    return false;

  }


  if (
    selectedPersonality === "custom"
  ) {


    const text =
    customPersonality.value.trim();


    if (!text) {

      alert(
        "自分で決める性格を入力してください！"
      );

      return false;

    }

  }


  return true;

}


/* =========================
   通話開始
========================= */

startButton.addEventListener(
"click",
async () => {


  if (
    stream
  ) {

    return;

  }


  if (
    !checkPersonality()
  ) {

    return;

  }


  try {


    stream =
    await navigator
    .mediaDevices
    .getUserMedia({

      audio: true

    });


    statusText.textContent =
    "通話中";


    startButton.textContent =
    "📞 通話中";


    startButton.classList.add(
      "calling"
    );


    seconds = 0;


    timer.textContent =
    "00:00";


    timerInterval =
    setInterval(() => {


      seconds++;


      const min =
      String(
        Math.floor(
          seconds / 60
        )
      ).padStart(
        2,
        "0"
      );


      const sec =
      String(
        seconds % 60
      ).padStart(
        2,
        "0"
      );


      timer.textContent =
      min + ":" + sec;


    }, 1000);


    /*
      現在は疑似通話です。

      次の段階で、
      音声認識 → AI → 音声合成
      をここへ接続します。
    */


  }

  catch(error) {


    console.error(error);


    statusText.textContent =
    "マイクを使用できません";


    alert(
      "マイクの使用を許可してください。"
    );


  }

});


/* =========================
   ミュート
========================= */

micButton.addEventListener(
"click",
() => {


  if (
    !stream
  ) {

    return;

  }


  const tracks =
  stream.getAudioTracks();


  tracks.forEach(track => {


    track.enabled =
    !track.enabled;


  });


  if (
    tracks[0].enabled
  ) {


    micButton.textContent =
    "🎙️";


  }

  else {


    micButton.textContent =
    "🔇";


  }

});


/* =========================
   通話終了
========================= */

document
.getElementById("endButton")
.addEventListener(
"click",
() => {


  if (
    stream
  ) {


    stream
    .getTracks()
    .forEach(track => {

      track.stop();

    });


    stream = null;

  }


  clearInterval(
    timerInterval
  );


  timerInterval =
  null;


  statusText.textContent =
  "通話終了";


  timer.textContent =
  "00:00";


  startButton.textContent =
  "📞 通話開始";


  startButton.classList.remove(
    "calling"
  );


  micButton.textContent =
  "🎙️";


});


</script>

</body>

</html>`, {

      headers: {

        "content-type":
        "text/html; charset=UTF-8"

      }

    });

  }

};
