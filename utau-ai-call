export default {
  async fetch(request, env) {

    const url = new URL(request.url);

    /* ==========================================
       AI API
    ========================================== */

    if (
      request.method === "POST" &&
      url.pathname === "/api/chat"
    ) {

      try {

        const body = await request.json();

        const message =
          String(body.message || "").trim();

        const personality =
          String(body.personality || "").trim();

        const customPersonality =
          String(body.customPersonality || "").trim();


        if (!message) {

          return Response.json(
            {
              error: "メッセージがありません。"
            },
            {
              status: 400
            }
          );

        }


        /* ======================================
           性格
        ====================================== */

        let personalityPrompt = "";


        if (personality === "tanaka") {

          personalityPrompt = `
あなたは「田中」という親しみやすいおじいちゃんAIです。

名前：田中
種族：人間
誕生日：1936年7月6日
一人称：ワシ

話し方：
・おじいちゃんらしい、やさしい話し方
・基本的に「〜じゃ」「〜じゃぞ」などを使う
・相手を傷つける言い方をしない
・普通の友達のように自然に会話する
・毎回「じゃ」を付ける必要はない
・短く自然な返事をする
・「！」や「？」をよく使う
・超人的な身体能力を持っている設定

電話で友達と話しているように、
自然で短い返事をしてください。
`;

        }

        else if (personality === "jagajaga") {

          personalityPrompt = `
あなたは「じゃがじゃが」という
明るく親しみやすいAIです。

性格：
・明るい
・元気
・楽しい
・少しユニーク
・親しみやすい
・相手を傷つけない

電話で友達と話しているように、
自然で短い返事をしてください。
`;

        }

        else if (personality === "custom") {

          personalityPrompt = `
あなたの性格は以下のユーザー設定です。

【性格設定】
${customPersonality}

この性格をできるだけ自然に再現してください。

電話で友達と話しているように、
自然で短い返事をしてください。

相手を傷つけるような返答は避けてください。
`;

        }

        else {

          personalityPrompt = `
あなたは親しみやすいAIです。

電話で友達と話しているように、
自然で短い返事をしてください。
`;

        }


        /* ======================================
           APIキー確認
        ====================================== */

        if (!env.GEMINI_API_KEY) {

          return Response.json(
            {
              error:
                "GEMINI_API_KEYがCloudflareに設定されていません。"
            },
            {
              status: 500
            }
          );

        }


        const apiKey =
          env.GEMINI_API_KEY;


        /* ======================================
           モデル
        ====================================== */

        let model =
          env.GEMINI_MODEL ||
          "gemini-3.6-flash";


        /*
          まず指定モデルを試します。

          もしモデルが存在しない場合は、
          Gemini APIから利用可能な
          generateContent対応モデルを探します。
        */


        async function callGemini(
          modelName
        ) {

          const endpoint =
            "https://generativelanguage.googleapis.com/v1beta/models/" +
            modelName +
            ":generateContent?key=" +
            encodeURIComponent(apiKey);


          const requestBody = {

            systemInstruction: {

              parts: [

                {
                  text:
                    personalityPrompt
                }

              ]

            },

            contents: [

              {

                role: "user",

                parts: [

                  {
                    text:
                      message
                  }

                ]

              }

            ],

            generationConfig: {

              temperature: 0.8,

              maxOutputTokens: 300

            }

          };


          const response =
            await fetch(
              endpoint,
              {

                method: "POST",

                headers: {

                  "Content-Type":
                    "application/json"

                },

                body:
                  JSON.stringify(requestBody)

              }
            );


          const data =
            await response.json();


          return {
            response,
            data
          };

        }


        let result =
          await callGemini(model);


        /* ======================================
           モデルが無い場合
        ====================================== */

        if (
          !result.response.ok &&
          (
            result.response.status === 404 ||
            result.data?.error?.status ===
              "NOT_FOUND"
          )
        ) {

          console.log(
            "指定モデルが使えないため、利用可能モデルを検索します。"
          );


          const modelsResponse =
            await fetch(
              "https://generativelanguage.googleapis.com/v1beta/models?key=" +
              encodeURIComponent(apiKey)
            );


          if (
            modelsResponse.ok
          ) {

            const modelsData =
              await modelsResponse.json();


            const models =
              modelsData.models || [];


            const available =
              models.find(
                m =>
                  Array.isArray(
                    m.supportedGenerationMethods
                  ) &&
                  m.supportedGenerationMethods
                    .includes(
                      "generateContent"
                    ) &&
                  /flash/i.test(
                    m.name || ""
                  )
              );


            if (available) {

              model =
                available.name
                  .replace(
                    /^models\//,
                    ""
                  );


              console.log(
                "使用モデル:",
                model
              );


              result =
                await callGemini(
                  model
                );

            }

          }

        }


        /* ======================================
           Geminiエラー
        ====================================== */

        if (
          !result.response.ok
        ) {

          console.error(
            "Gemini API error:",
            JSON.stringify(
              result.data
            )
          );


          return Response.json(
            {
              error:
                "Gemini APIでエラーが発生しました。",

              detail:
                result.data?.error?.message ||
                "Unknown API error"
            },
            {
              status:
                result.response.status
            }
          );

        }


        /* ======================================
           AIの返事
        ====================================== */

        const reply =
          result.data
            ?.candidates?.[0]
            ?.content?.parts?.[0]
            ?.text;


        if (!reply) {

          return Response.json(
            {
              error:
                "AIから返事を取得できませんでした。"
            },
            {
              status: 502
            }
          );

        }


        return Response.json({

          reply: reply.trim(),

          model: model

        });

      }

      catch (error) {

        console.error(error);


        return Response.json(
          {
            error:
              "サーバー側でエラーが発生しました。",

            detail:
              error?.message ||
              String(error)
          },
          {
            status: 500
          }
        );

      }

    }


    /* ==========================================
       HTML
    ========================================== */

    return new Response(`<!DOCTYPE html>

